				<width>1.6</width>
			</LineStyle>
			<PolyStyle>
				<color>4d0000ff</color>
			</PolyStyle>
			<BalloonStyle>
				<text><![CDATA[<b>Major Event:</b> Drive-through ATM video evidence location<br/>
<b>Bank Name:</b> Community South Bank (later acquired by CB&S Bank)<br/>
<b>Address:</b> 51 West Main Street, Parsons, TN 38363<br/>
<b>Evidence:</b> Drive-through ATM video<br/>
<b>Time:</b> April 13, 2011 at approximately 11:12 AM<br/>
<b>Vehicle:</b> White Chevrolet Silverado<br/>
<b>Significance:</b> Contradicts State's timeline - places Adams in Parsons during the time Autry alleged they were at Tennessee River disposing of body. Trial counsel admitted failing to present this video was a significant error, calling it a "partial alibi"]]></text>
			</BalloonStyle>
		</Style>
	</gx:CascadingStyle>
	<gx:CascadingStyle kml:id="__managed_style_B7932FFFA73E8027A078">
		<Style>
			<IconStyle>
				<scale>1.2</scale>
				<Icon>
					<href>https://earth.google.com/earth/document/icon?color=1976d2&amp;id=2000&amp;scale=4</href>
				</Icon>
				<hotSpot x="64" y="128" xunits="pixels" yunits="insetPixels"/>
			</IconStyle>
			<LabelStyle>
				<color>ff0000ff</color>
				<scale>2.5</scale>
			</LabelStyle>
			<LineStyle>
				<color>ff0000ff</color>
				<width>2.4</width>
			</LineStyle>
			<PolyStyle>
				<color>4d0000ff</color>
			</PolyStyle>
			<BalloonStyle>
				<text><![CDATA[<b>Major Event:</b> Drive-through ATM video evidence location<br/>
<b>Bank Name:</b> Community South Bank (later acquired by CB&S Bank)<br/>
<b>Address:</b> 51 West Main Street, Parsons, TN 38363<br/>
<b>Evidence:</b> Drive-through ATM video<br/>
<b>Time:</b> April 13, 2011 at approximately 11:12 AM<br/>
<b>Vehicle:</b> White Chevrolet Silverado<br/>
<b>Significance:</b> Contradicts State's timeline - places Adams in Parsons during the time Autry alleged they were at Tennessee River disposing of body. Trial counsel admitted failing to present this video was a significant error, calling it a "partial alibi"]]></text>
			</BalloonStyle>
		</Style>
	</gx:CascadingStyle>
