		<Folder id="5983403BE2000007">
			<name>KEY LOCATIONS AND EVIDENCE RECOVERY</name>
			<styleUrl>#__managed_style_091FA8AF7C3E8027A06F</styleUrl>
			<Placemark id="5983403BE2000008">
				<name>HOLLY BOBO&apos;S</name>
				<description><![CDATA[<b>Event:</b> Kidnapping scene; neighbor James Barnes heard screaming here at ~7:45–7:50 a.m. <b>[cite: 53-54]</b><br/>
      <b>Evidence:</b> Blood containing the victim's DNA found on the garage floor. <b>[cite: 45]</b><br/>
      <b>Witness:</b> The victim's brother reported seeing the victim walking into the woods from here. <b>[cite: 107]</b><br/>
      <b>Notes:</b> Residence address listed in this file as 681 Swan Johnson Road.<br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<ExtendedData>
					<SchemaData schemaUrl="#__managed_schema">
						<SimpleData name="COL593B4A5607B112E8">Residence / kidnapping scene</SimpleData>
						<SimpleData name="COL593B4A56078FF545">2011-04-13</SimpleData>
						<SimpleData name="COL593B4A56077F3D27">45;53-54;107</SimpleData>
						<SimpleData name="COL593B4A56070D8F2D">2022 appellate opinion (State v. Zachary Rye Adams)</SimpleData>
					</SchemaData>
				</ExtendedData>
				<Point>
					<coordinates>-88.1758007,35.6792874,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000009">
				<name>LUNCHBOX RECOVERY SITE (GRAVES PROPERTY)</name>
				<description><![CDATA[<b>Recovered by:</b> Jon Graves.<br/>
      <b>Description:</b> Graves found the victim's lunchbox (containing a sandwich) in a creek on his property while searching barns. <b>[cite: 268]</b><br/>
      <b>Date:</b> 2011-04-14 (reported found). <b>[cite: 265]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<ExtendedData>
					<SchemaData schemaUrl="#__managed_schema">
						<SimpleData name="COL593B4A5607B112E8">Evidence recovery</SimpleData>
						<SimpleData name="COL593B4A56078FF545">2011-04-14</SimpleData>
						<SimpleData name="COL593B4A56077F3D27">265;268</SimpleData>
						<SimpleData name="COL593B4A56070D8F2D">2022 appellate opinion (State v. Zachary Rye Adams)</SimpleData>
					</SchemaData>
				</ExtendedData>
				<Point>
					<coordinates>-88.1343227,35.731971,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE200000A">
				<name>YELLOW SPRINGS COMMUNITY (PAPER FOUND)</name>
				<description><![CDATA[<b>Recovered by:</b> Gerald Stephens.<br/>
      <b>Description:</b> Found a "wadded up" paper with the victim's name, address, and handwriting. <b>[cite: 273]</b><br/>
      <b>Location detail:</b> About 300–400 feet from where underwear (not belonging to the victim) was found. <b>[cite: 273]</b><br/>
      <b>Location detail:</b> About 75 feet from Austin's driveway. <b>[cite: 487]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<Point>
					<coordinates>-88.1233707,35.8103424,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE200000B">
				<name>RECEIPT RECOVERY LOCATION</name>
				<description><![CDATA[<b>Description:</b> Trooper Rainey described driving routes where evidence was recovered, including a credit-card receipt with the victim's name. <b>[cite: 158]</b><br/>
      <b>Location detail:</b> In the Yellow Springs and Holladay communities area. <b>[cite: 158]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<Point>
					<coordinates>-88.1213405,35.8070377,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE200000C">
				<name>CELL PHONE RECOVERY SITE</name>
				<description><![CDATA[<b>Recovered by:</b> Emily Pratt and search team.<br/>
      <b>Date:</b> 2011-04-24 (reported found). <b>[cite: 276]</b><br/>
      <b>Location detail:</b> About five miles from the victim's home. <b>[cite: 277]</b><br/>
      <b>Notes:</b> Point placement is approximate.<br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<ExtendedData>
					<SchemaData schemaUrl="#__managed_schema">
						<SimpleData name="COL593B4A5607B112E8">Evidence recovery</SimpleData>
						<SimpleData name="COL593B4A56078FF545">2011-04-24</SimpleData>
						<SimpleData name="COL593B4A56077F3D27">276;277</SimpleData>
						<SimpleData name="COL593B4A56070D8F2D">2022 appellate opinion (State v. Zachary Rye Adams)</SimpleData>
						<SimpleData name="COL593B4A56072A2CC3">approx</SimpleData>
					</SchemaData>
				</ExtendedData>
				<Point>
					<coordinates>-88.1146431,35.6849778,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE200000D">
				<name>SIM CARD RECOVERY SITE</name>
				<description><![CDATA[<b>Recovered by:</b> Ednesha Brasher's brother.<br/>
      <b>Date:</b> 2011-05-02 (reported found). <b>[cite: 278]</b><br/>
      <b>Context:</b> Found while riding bicycles near the victim's home. <b>[cite: 278]</b><br/>
      <b>Notes:</b> Some other accounts list 2011-05-03; retain the appellate-opinion date above as the cited reference.<br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<ExtendedData>
					<SchemaData schemaUrl="#__managed_schema">
						<SimpleData name="COL593B4A5607B112E8">Evidence recovery</SimpleData>
						<SimpleData name="COL593B4A56078FF545">2011-05-02</SimpleData>
						<SimpleData name="COL593B4A56077F3D27">278</SimpleData>
						<SimpleData name="COL593B4A56070D8F2D">2022 appellate opinion (State v. Zachary Rye Adams)</SimpleData>
					</SchemaData>
				</ExtendedData>
				<Point>
					<coordinates>-88.1194067,35.6584578,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE200000E">
				<name>REMAINS RECOVERY SITE</name>
				<description><![CDATA[<b>Recovered by:</b> Ernest "Larry" Stone (ginseng hunter).<br/>
      <b>Date:</b> 2014-09-07 (reported located). <b>[cite: 282]</b><br/>
      <b>Description:</b> A skull was found under an upside-down bucket in the woods near a cell phone tower. <b>[cite: 282-284]</b><br/>
      <b>Location detail:</b> About three miles from Austin's home; about five miles from the Defendant's home. <b>[cite: 507]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<ExtendedData>
					<SchemaData schemaUrl="#__managed_schema">
						<SimpleData name="COL593B4A5607B112E8">Evidence recovery</SimpleData>
						<SimpleData name="COL593B4A56078FF545">2014-09-07</SimpleData>
						<SimpleData name="COL593B4A56077F3D27">282-284;507</SimpleData>
						<SimpleData name="COL593B4A56070D8F2D">2022 appellate opinion (State v. Zachary Rye Adams)</SimpleData>
					</SchemaData>
				</ExtendedData>
				<Point>
					<coordinates>-88.16926100000001,35.8215758,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE200000F">
				<name>PISTOL RECOVERY (JOE HOLLADAY ROAD)</name>
				<description><![CDATA[<b>Recovered by:</b> Steve Deaton (lead diver).<br/>
      <b>Date:</b> 2017-05-25 (reported recovered). <b>[cite: 516]</b><br/>
      <b>Location detail:</b> In a creek-like "drainage feature" along Joe Holladay Road. <b>[cite: 516]</b><br/>
      <b>Context:</b> Victor Dinsmore testified his wife disposed of the pistol in a creek 3–4 miles from Yellow Springs Road. <b>[cite: 1093]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_9B81449D523E8027A070</styleUrl>
				<ExtendedData>
					<SchemaData schemaUrl="#__managed_schema">
						<SimpleData name="COL593B4A5607B112E8">Evidence recovery</SimpleData>
						<SimpleData name="COL593B4A56078FF545">2017-05-25</SimpleData>
						<SimpleData name="COL593B4A56077F3D27">516;1093</SimpleData>
						<SimpleData name="COL593B4A56070D8F2D">2022 appellate opinion (State v. Zachary Rye Adams)</SimpleData>
					</SchemaData>
				</ExtendedData>
				<Point>
					<coordinates>-88.154404,35.8410278,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000010">
				<name>BIRDSONG BRIDGE / I-40 CROSSING</name>
				<description><![CDATA[<b>Testimony:</b> Jason Autry testified they took the body to the Tennessee River under the Interstate 40 bridge. <b>[cite: 321]</b><br/>
      <b>Evidence:</b> Nursing papers found where the bridge crosses over I-40. <b>[cite: 489]</b><br/>
      <b>Statements:</b> Defendant reportedly said to "put up under the Birdsong bridge." <b>[cite: 251]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_CAF61B302C3E8027A070</styleUrl>
				<Point>
					<coordinates>-87.9434109,35.8680952,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000011">
				<name>THE &quot;OLD BARN&quot; (HICKERSON PROPERTY)</name>
				<description><![CDATA[<b>Testimony:</b> Jason Autry searched his late grandmother's barn on Yellow Springs Road for evidence. <b>[cite: 376]</b><br/>
      <b>Witness:</b> Brian Vitt lived across from the barn. <b>[cite: 415]</b><br/>
      <b>Status:</b> Reported destroyed in late 2012 or early 2013. <b>[cite: 752]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_CAF61B302C3E8027A070</styleUrl>
				<Point>
					<coordinates>-88.1277967,35.8159405,0</coordinates>
				</Point>
			</Placemark>
		</Folder>
		<Folder id="5983403BE2000012">
			<name>PEOPLE AND RESIDENCES</name>
			<styleUrl>#__managed_style_091FA8AF7C3E8027A06F</styleUrl>
			<Placemark id="5983403BE2000013">
				<name>ZACHARY ADAMS&apos;s</name>
				<description><![CDATA[<b>Location detail:</b> Located north of Parsons, near Holladay, not far from Yellow Springs Road. <b>[cite: 159]</b><br/>
      <b>Testimony:</b> Autry arrived here at ~2:30 p.m. and reported seeing the men fighting. <b>[cite: 341]</b><br/>
      <b>Testimony:</b> Stephen Young reported seeing the Defendant vacuuming a truck here. <b>[cite: 176]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<Point>
					<coordinates>-88.0837789,35.8214583,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000014">
				<name>SHAYNE AUSTIN</name>
				<description><![CDATA[<b>Testimony:</b> Autry arrived here around 9:00 a.m. on 2011-04-13. <b>[cite: 308]</b><br/>
      <b>Observation:</b> Autry reported seeing a large fire in a burn barrel; the victim's father later reported seeing a burn barrel here. <b>[cite: 308, 952]</b><br/>
      <b>Location:</b> Yellow Springs community. <b>[cite: 308]</b><br/>
      <b>Notes:</b> Address commonly listed as 30 Yellow Spring Rd (not a court label).<br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<Point>
					<coordinates>-88.1204944,35.8064745,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000015">
				<name>BRENDA O&apos;BRYANT / KELLY RIDGE</name>
				<description><![CDATA[<b>Testimony:</b> Brenda O'Bryant's parents lived across from "Kelly Ridge". <b>[cite: 423]</b><br/>
      <b>Testimony:</b> A man (identified as Autry) asked to fish in their ponds. <b>[cite: 425]</b><br/>
      <b>Statement:</b> Defendant told Autry "we throwed her out near Kelly Ridge." <b>[cite: 356]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<Point>
					<coordinates>-88.1408102,35.8229219,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000016">
				<name>ANGELA SCOTT</name>
				<description><![CDATA[<b>Identity:</b> Angela Scott was Jason Autry's girlfriend. <b>[cite: 431]</b><br/>
      <b>Location:</b> Camden area (tied to cell-tower data described near her home). <b>[cite: 551]</b><br/>
      <b>Notes:</b> Coordinate represents a mapped residence point used in this file.<br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<Point>
					<coordinates>-88.069439,36.022526,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000017">
				<name>DOTTIE COOLEY&apos;S</name>
				<description><![CDATA[<b>Testimony:</b> The men drove to Dottie Cooley's home to meet Victor Dinsmore. <b>[cite: 345]</b><br/>
      <b>Location detail:</b> About two miles from the Defendant's home. <b>[cite: 345]</b><br/>
      <b>Witness:</b> Cleaner Debbie Dorris reported seeing three men there between ~2:30 and 3:30 p.m. <b>[cite: 521]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<Point>
					<coordinates>-88.0984935,35.8186527,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000018">
				<name>VICTOR DINSMORE&apos;S</name>
				<description><![CDATA[<b>Location:</b> Yellow Springs Road in the Holladay community. <b>[cite: 436]</b><br/>
      <b>Proximity:</b> The victim's remains were found less than two miles from this location. <b>[cite: 470]</b><br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
				<styleUrl>#__managed_style_62E83A14C43E8027A070</styleUrl>
				<Point>
					<coordinates>-88.1394212,35.8184545,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="5983403BE2000019">
				<name>VICTOR DINSMORE&apos;S SHOP</name>
				<description><![CDATA[<b>Testimony:</b> Defendant hid his white truck in Dinsmore's shop. <b>[cite: 452]</b><br/>
      <b>Notes:</b> Coordinate represents a mapped shop location near Dinsmore's residence.<br/>
      <b>Source:</b> 2022 appellate opinion (State v. Zachary Rye Adams), line refs above
      ]]></description>
